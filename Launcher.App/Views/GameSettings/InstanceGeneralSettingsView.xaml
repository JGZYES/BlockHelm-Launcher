<UserControl x:Class="Launcher.App.Views.GameSettings.InstanceGeneralSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:Launcher.App.Behaviors"
             xmlns:controls="clr-namespace:Launcher.App.Controls"
             xmlns:services="clr-namespace:Launcher.Application.Services;assembly=Launcher.Application"
             xmlns:res="clr-namespace:Launcher.App.Resources"
             Focusable="False">
    <StackPanel>
        <Image Width="64"
               Height="64"
               HorizontalAlignment="Left"
               Source="{Binding InstanceIconSource, Converter={StaticResource IconSourceImageConverter}}"
               Stretch="UniformToFill"
               behaviors:RoundedClip.Radius="8"
               SnapsToDevicePixels="True"
               RenderOptions.BitmapScalingMode="NearestNeighbor" />

        <Grid Margin="0,18,0,0"
              HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding InstanceName}"
                       VerticalAlignment="Center"
                       Style="{StaticResource PageTitleTextStyle}" />

            <Button Grid.Column="1"
                    Margin="10,0,0,0"
                    Style="{StaticResource InlineIconButtonStyle}"
                    Command="{Binding RequestEditInstanceCommand}">
                <controls:SvgIcon Width="16"
                                  Height="16"
                                  IconKey="general/general_edit"
                                  Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
            </Button>
        </Grid>

        <TextBlock Margin="0,8,0,0"
                   Text="{Binding InstanceSubtitle}"
                   Foreground="{DynamicResource Brush.8FFFFFFF}"
                   FontSize="12" />

        <StackPanel Margin="0,26,0,0">
            <GroupBox Header="{x:Static res:Strings.GameSettings_GeneralDescriptionSection}"
                      Style="{StaticResource LauncherContentSectionStyle}">
                <StackPanel>
                    <TextBox x:Name="DescriptionTextBox"
                             Loaded="DescriptionTextBox_OnLoaded"
                             TextChanged="DescriptionTextBox_OnTextChanged"
                             SizeChanged="DescriptionTextBox_OnSizeChanged"
                             MinLines="1"
                             Style="{StaticResource LauncherDialogWrappingTextBoxStyle}"
                             Text="{Binding DescriptionText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </GroupBox>

            <GroupBox Margin="0,26,0,0"
                      Header="{x:Static res:Strings.GameSettings_GeneralLoaderUpgradeSection}"
                      Style="{StaticResource LauncherContentSectionStyle}">
                <StackPanel>
                    <TextBlock Margin="0,0,0,8"
                               Text="{Binding VanillaLoaderUpgradeStatusText}"
                               Foreground="{DynamicResource Brush.8FFFFFFF}"
                               TextWrapping="Wrap" />

                    <controls:AnimatedComboBox Height="32"
                              MinWidth="220"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding AvailableLoaderOptions}"
                              SelectedItem="{Binding SelectedLoaderOption, Mode=TwoWay}"
                              IsEnabled="{Binding CanUseVanillaLoaderUpgrade}">
                        <controls:AnimatedComboBox.Style>
                            <Style TargetType="controls:AnimatedComboBox" BasedOn="{StaticResource LauncherComboBoxStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVanillaInstance}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:AnimatedComboBox.Style>
                        <controls:AnimatedComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type services:VanillaUpgradeLoaderOption}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Loader}" />
                                    <TextBlock Text=" - " Foreground="{DynamicResource Brush.8FFFFFFF}" />
                                    <TextBlock Text="{Binding DisplayVersion}" />
                                </StackPanel>
                            </DataTemplate>
                        </controls:AnimatedComboBox.ItemTemplate>
                        <controls:AnimatedComboBox.SelectionItemTemplate>
                            <DataTemplate DataType="{x:Type services:VanillaUpgradeLoaderOption}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Loader}" />
                                    <TextBlock Text=" - " Foreground="{DynamicResource Brush.8FFFFFFF}" />
                                    <TextBlock Text="{Binding DisplayVersion}" />
                                </StackPanel>
                            </DataTemplate>
                        </controls:AnimatedComboBox.SelectionItemTemplate>
                    </controls:AnimatedComboBox>

                    <StackPanel Orientation="Horizontal">
                        <Border Margin="0,14,12,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVanillaInstance}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Button HorizontalAlignment="Left"
                                    Content="{x:Static res:Strings.GameSettings_GeneralLoaderUpgradeButton}"
                                    Command="{Binding StartVanillaLoaderUpgradeCommand}"
                                    Style="{StaticResource LauncherPrimaryDialogButtonStyle}" />
                        </Border>

                        <Border Margin="0,14,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanRetryAvailableLoaders}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Button HorizontalAlignment="Left"
                                    Content="{x:Static res:Strings.GameSettings_GeneralLoaderUpgradeRetryButton}"
                                    Command="{Binding ReloadAvailableLoadersCommand}"
                                    Style="{StaticResource SecondaryMenuButtonStyle}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Margin="0,26,0,0"
                      Header="{x:Static res:Strings.GameSettings_GeneralInstanceDirectorySection}"
                      Style="{StaticResource LauncherContentSectionStyle}">
                <Button HorizontalAlignment="Left"
                        Content="{x:Static res:Strings.GameSettings_GeneralOpenInstanceDirectoryButton}"
                        Command="{Binding OpenInstanceDirectoryCommand}"
                        Style="{StaticResource LauncherPrimaryDialogButtonStyle}" />
            </GroupBox>

            <GroupBox Margin="0,26,0,0"
                      Header="{x:Static res:Strings.GameSettings_GeneralCreatedAtSection}"
                      Style="{StaticResource LauncherContentSectionStyle}">
                <Border Style="{StaticResource ReadOnlyFieldSurfaceStyle}">
                    <TextBlock Text="{Binding InstanceCreatedAtText}"
                               Style="{StaticResource ReadOnlyFieldTextStyle}" />
                </Border>
            </GroupBox>

            <Button Margin="0,26,0,0"
                    HorizontalAlignment="Left"
                    Content="{x:Static res:Strings.GameSettings_DeleteGameButton}"
                    Command="{Binding RequestDeleteInstanceCommand}"
                    Style="{StaticResource LauncherDangerDialogButtonStyle}" />
        </StackPanel>
    </StackPanel>
</UserControl>
