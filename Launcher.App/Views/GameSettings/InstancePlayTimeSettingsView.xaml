<UserControl x:Class="Launcher.App.Views.GameSettings.InstancePlayTimeSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gameSettings="clr-namespace:Launcher.App.ViewModels.GameSettings"
             xmlns:res="clr-namespace:Launcher.App.Resources"
             Focusable="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BlockHelm_Launcher_x64;component/Views/GameSettings/GameSettingsSectionResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid ClipToBounds="True">
        <ScrollViewer Style="{StaticResource ListPageScrollViewerStyle}">
            <StackPanel Margin="0,132,12,96"
                        MaxWidth="{StaticResource DetailPageContentMaxWidth}"
                        HorizontalAlignment="Stretch">

                <!-- 总游戏时长 -->
                <GroupBox Header="{x:Static res:Strings.PlayTime_TotalPlayTime}"
                          Style="{StaticResource LauncherContentSectionStyle}">
                    <Border Style="{StaticResource SectionFieldSurfaceStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding TotalPlayTimeText}"
                                       FontSize="32"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text.Primary}" />

                            <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                                <StackPanel Width="120">
                                    <TextBlock Text="{x:Static res:Strings.PlayTime_TodayPlayTime}"
                                               Foreground="{DynamicResource Brush.Text.Muted}"
                                               FontSize="12" />
                                    <TextBlock Text="{Binding TodayPlayTimeText}"
                                               Foreground="{DynamicResource Brush.Text.Primary}"
                                               FontSize="14"
                                               Margin="0,4,0,0" />
                                </StackPanel>

                                <StackPanel Width="120" Margin="24,0,0,0">
                                    <TextBlock Text="{x:Static res:Strings.PlayTime_WeekPlayTime}"
                                               Foreground="{DynamicResource Brush.Text.Muted}"
                                               FontSize="12" />
                                    <TextBlock Text="{Binding WeekPlayTimeText}"
                                               Foreground="{DynamicResource Brush.Text.Primary}"
                                               FontSize="14"
                                               Margin="0,4,0,0" />
                                </StackPanel>

                                <StackPanel Width="120" Margin="24,0,0,0">
                                    <TextBlock Text="{x:Static res:Strings.PlayTime_SessionCount}"
                                               Foreground="{DynamicResource Brush.Text.Muted}"
                                               FontSize="12" />
                                    <TextBlock Text="{Binding SessionCount, StringFormat={}{0} 次}"
                                               Foreground="{DynamicResource Brush.Text.Primary}"
                                               FontSize="14"
                                               Margin="0,4,0,0" />
                                </StackPanel>

                                <StackPanel Width="160" Margin="24,0,0,0">
                                    <TextBlock Text="{x:Static res:Strings.PlayTime_LastPlayed}"
                                               Foreground="{DynamicResource Brush.Text.Muted}"
                                               FontSize="12" />
                                    <TextBlock Text="{Binding LastPlayedText}"
                                               Foreground="{DynamicResource Brush.Text.Primary}"
                                               FontSize="14"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </GroupBox>

                <!-- 最近启动记录 -->
                <GroupBox Margin="0,26,0,0"
                          Header="{x:Static res:Strings.PlayTime_RecentSessions}"
                          Style="{StaticResource LauncherContentSectionStyle}">
                    <Border Style="{StaticResource SectionFieldSurfaceStyle}">
                        <StackPanel>
                            <ListBox ItemsSource="{Binding RecentSessions}"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Margin" Value="0,2" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,6,0,6" ClipToBounds="True">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Grid.Column="0"
                                                     Width="8"
                                                     Height="8"
                                                     HorizontalAlignment="Left"
                                                     VerticalAlignment="Center"
                                                     Fill="{DynamicResource Brush.Text.Muted}">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Text.Muted}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource Brush.AccentOption.Emerald}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>

                                            <TextBlock Grid.Column="0"
                                                       Margin="14,0,0,0"
                                                       Text="{Binding StartedAtText}"
                                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                                       FontSize="13"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap" />

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Session.InstanceName}"
                                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                                       FontSize="13"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       VerticalAlignment="Center" />

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding DurationText}"
                                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                                       FontSize="13"
                                                       TextAlignment="Right"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="{x:Static res:Strings.PlayTime_NoHistory}"
                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       Margin="0,16,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPlayTimeData}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>