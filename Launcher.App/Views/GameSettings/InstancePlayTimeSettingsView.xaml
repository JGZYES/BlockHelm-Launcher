<UserControl x:Class="Launcher.App.Views.GameSettings.InstancePlayTimeSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gameSettings="clr-namespace:Launcher.App.ViewModels.GameSettings"
             xmlns:res="clr-namespace:Launcher.App.Resources"
             Focusable="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BlockHelm_Launcher_x64;component/Views/GameSettings/GameSettingsSectionResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid ClipToBounds="True">
        <ScrollViewer Style="{StaticResource ListPageScrollViewerStyle}">
            <StackPanel Margin="0,132,12,96"
                        MaxWidth="{StaticResource DetailPageContentMaxWidth}"
                        HorizontalAlignment="Stretch">

                <!-- 总游戏时长 -->
                <GroupBox Header="{x:Static res:Strings.PlayTime_TotalPlayTime}"
                          Style="{StaticResource LauncherContentSectionStyle}">
                    <Border Style="{StaticResource SectionFieldSurfaceStyle}">
                        <StackPanel>
                            <TextBlock Text="{Binding TotalPlayTimeText}"
                                       FontSize="32"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text.Primary}" />

                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1.4*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Style="{StaticResource SectionFieldSurfaceStyle}"
                                        Padding="12,10">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static res:Strings.PlayTime_TodayPlayTime}"
                                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                                   FontSize="12" />
                                        <TextBlock Text="{Binding TodayPlayTimeText}"
                                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1"
                                        Style="{StaticResource SectionFieldSurfaceStyle}"
                                        Padding="12,10"
                                        Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static res:Strings.PlayTime_WeekPlayTime}"
                                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                                   FontSize="12" />
                                        <TextBlock Text="{Binding WeekPlayTimeText}"
                                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Style="{StaticResource SectionFieldSurfaceStyle}"
                                        Padding="12,10"
                                        Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static res:Strings.PlayTime_SessionCount}"
                                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                                   FontSize="12" />
                                        <TextBlock Text="{Binding SessionCount, StringFormat={}{0} 次}"
                                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="3"
                                        Style="{StaticResource SectionFieldSurfaceStyle}"
                                        Padding="12,10"
                                        Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static res:Strings.PlayTime_LastPlayed}"
                                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                                   FontSize="12" />
                                        <TextBlock Text="{Binding LastPlayedText}"
                                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </GroupBox>

                <!-- 最近启动记录 -->
                <GroupBox Margin="0,26,0,0"
                          Header="{x:Static res:Strings.PlayTime_RecentSessions}"
                          Style="{StaticResource LauncherContentSectionStyle}">
                    <Border Style="{StaticResource SectionFieldSurfaceStyle}">
                        <StackPanel>
                            <ListBox ItemsSource="{Binding RecentSessions}"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Margin" Value="0,0,0,8" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="CardBorder"
                                                Background="{DynamicResource Brush.Card.Surface}"
                                                BorderBrush="{DynamicResource Brush.18FFFFFF}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="14,12">
                                            <Grid ClipToBounds="True">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="100" />
                                                </Grid.ColumnDefinitions>

                                                <Ellipse Grid.Column="0"
                                                         Width="8"
                                                         Height="8"
                                                         HorizontalAlignment="Left"
                                                         VerticalAlignment="Center"
                                                         Fill="{DynamicResource Brush.Text.Muted}">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Setter Property="Fill" Value="{DynamicResource Brush.Text.Muted}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Fill" Value="{DynamicResource Brush.AccentOption.Emerald}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>

                                                <StackPanel Grid.Column="1"
                                                            Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding StartedAtText}"
                                                               Foreground="{DynamicResource Brush.Text.Secondary}"
                                                               FontSize="12"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Session.InstanceName}"
                                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap"
                                                           VerticalAlignment="Center" />

                                                <Border Grid.Column="3"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource Brush.Accent.Soft}"
                                                        CornerRadius="8"
                                                        Padding="8,4">
                                                    <TextBlock Text="{Binding DurationText}"
                                                               Foreground="{DynamicResource Brush.Accent.Normal}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="NoWrap"
                                                               TextAlignment="Right" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource Brush.Card.Hover}" />
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="{x:Static res:Strings.PlayTime_NoHistory}"
                                       Foreground="{DynamicResource Brush.Text.Muted}"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       Margin="0,16,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPlayTimeData}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>