<UserControl x:Class="Launcher.App.Views.Settings.InfoSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Launcher.App.Controls"
             xmlns:res="clr-namespace:Launcher.App.Resources"
             Focusable="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BlockHelm_Launcher_x64;component/Views/Settings/SettingsSectionResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="AvatarToolTip" TargetType="ToolTip">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border CornerRadius="8"
                                    Padding="14,10"
                                    Background="{DynamicResource Brush.Surface.Popup}"
                                    BorderBrush="{DynamicResource Brush.Surface.WindowBorder}"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect Color="#80000000" BlurRadius="20" ShadowDepth="3" Opacity="0.25" />
                                </Border.Effect>
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="AvatarToolTipTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="AvatarToolTipDesc" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                <Setter Property="FontSize" Value="12" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Margin="0,0,12,72"
                MaxWidth="{StaticResource DetailPageContentMaxWidth}"
                HorizontalAlignment="Stretch">
        <StackPanel HorizontalAlignment="Left">
            <Image Width="64"
                   Height="64"
                   HorizontalAlignment="Left"
                   Source="/BlockHelm_Launcher_x64;component/Assets/Icons/app_icon_concept_256.png"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Margin="0,10,0,0"
                       Text="{x:Static res:Strings.App_Title}"
                       Foreground="{DynamicResource Brush.Text.Primary}"
                       FontSize="26"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />

            <TextBlock Margin="0,16,0,0"
                       Text="{Binding LauncherVersionText, StringFormat=v{0}}"
                       Foreground="{DynamicResource Brush.Text.Primary}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="48"
                        Height="48"
                        CornerRadius="24"
                        ClipToBounds="True"
                        Cursor="Hand"
                        MouseLeftButtonDown="Avatar_MouseLeftButtonDown">
                    <Border.Clip>
                        <EllipseGeometry RadiusX="24" RadiusY="24" Center="24,24" />
                    </Border.Clip>
                    <Border.ToolTip>
                        <ToolTip Style="{StaticResource AvatarToolTip}" Placement="Top">
                            <StackPanel>
                                <TextBlock Style="{StaticResource AvatarToolTipTitle}"
                                           Text="二次开发作者：JGZ_YES" />
                                <TextBlock Style="{StaticResource AvatarToolTipDesc}"
                                           Margin="0,3,0,0"
                                           Text="点击头像查看 GitHub 主页" />
                            </StackPanel>
                        </ToolTip>
                    </Border.ToolTip>
                    <Image Source="/BlockHelm_Launcher_x64;component/Assets/Icons/avatar/avatar.jpg"
                           Stretch="UniformToFill" />
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="JGZ_YES"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               FontSize="14"
                               FontWeight="SemiBold" />
                    <TextBlock Text="二次开发作者"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               FontSize="12"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <WrapPanel Margin="0,16,0,0">
                <Button Margin="0,0,10,10"
                        Content="{x:Static res:Strings.Settings_ViewGithubRepositoryButton}"
                        Command="{Binding OpenGithubRepositoryCommand}"
                        Style="{StaticResource LauncherDialogButtonStyle}" />
                <Button x:Name="CheckUpdatesButton"
                        Margin="0,0,10,10"
                        Content="{Binding CheckUpdatesButtonText}"
                        Command="{Binding CheckUpdatesCommand}"
                        RequestBringIntoView="CheckUpdatesButton_OnRequestBringIntoView"
                        Style="{StaticResource LauncherPrimaryDialogButtonStyle}" />
            </WrapPanel>
        </StackPanel>

        <GroupBox Margin="0,28,0,0"
                  Header="{x:Static res:Strings.Settings_DerivativeWorkDeclarationTitle}"
                  Style="{StaticResource LauncherContentSectionStyle}">
            <Border Style="{StaticResource SectionFieldSurfaceStyle}">
                <TextBlock Text="{x:Static res:Strings.Settings_DerivativeWorkDeclaration}"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           FontSize="13"
                           TextWrapping="Wrap" />
            </Border>
        </GroupBox>

        <GroupBox Margin="0,28,0,0"
                  Header="{x:Static res:Strings.Settings_UpdateSection}"
                  Style="{StaticResource LauncherContentSectionStyle}">
            <Border Style="{StaticResource SectionFieldSurfaceStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{x:Static res:Strings.Settings_UpdateChannelLabel}"
                               Style="{StaticResource SettingsOptionTextStyle}" />

                    <controls:AnimatedComboBox Grid.Column="1"
                                               ItemsSource="{Binding UpdateChannelOptions}"
                                               SelectedItem="{Binding SelectedUpdateChannelOption, Mode=TwoWay}"
                                               ItemTemplate="{StaticResource UpdateChannelOptionTemplate}"
                                               SelectionItemTemplate="{StaticResource UpdateChannelOptionTemplate}"
                                               Style="{StaticResource LauncherComboBoxStyle}" />
                </Grid>
            </Border>
        </GroupBox>

        <GroupBox Margin="0,28,0,0"
                  Header="{x:Static res:Strings.Settings_LegalSection}"
                  Style="{StaticResource LauncherContentSectionStyle}">
            <Border Style="{StaticResource SectionFieldSurfaceStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Static res:Strings.Settings_CopyrightNotice}"
                                       Style="{StaticResource SettingsOptionTextStyle}" />
                            <TextBlock Margin="0,4,16,0"
                                       Text="{x:Static res:Strings.Settings_CopyrightNoticeDescription}"
                                       Style="{StaticResource SettingsDescriptionTextStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Margin="20,0,0,0"
                                VerticalAlignment="Center"
                                Content="{x:Static res:Strings.Settings_ViewLegalDocumentButton}"
                                Command="{Binding OpenCopyrightNoticeCommand}"
                                Style="{StaticResource LauncherDialogButtonStyle}" />
                    </Grid>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Static res:Strings.Settings_OpenSourceLicense}"
                                       Style="{StaticResource SettingsOptionTextStyle}" />
                            <TextBlock Margin="0,4,16,0"
                                       Text="{x:Static res:Strings.Settings_OpenSourceLicenseDescription}"
                                       Style="{StaticResource SettingsDescriptionTextStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Margin="20,0,0,0"
                                VerticalAlignment="Center"
                                Content="{x:Static res:Strings.Settings_ViewLegalDocumentButton}"
                                Command="{Binding OpenOpenSourceLicenseCommand}"
                                Style="{StaticResource LauncherDialogButtonStyle}" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Static res:Strings.Settings_UserAgreement}"
                                       Style="{StaticResource SettingsOptionTextStyle}" />
                            <TextBlock Margin="0,4,16,0"
                                       Text="{x:Static res:Strings.Settings_UserAgreementDescription}"
                                       Style="{StaticResource SettingsDescriptionTextStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Margin="20,0,0,0"
                                VerticalAlignment="Center"
                                Content="{x:Static res:Strings.Settings_ViewLegalDocumentButton}"
                                Command="{Binding OpenUserAgreementCommand}"
                                Style="{StaticResource LauncherDialogButtonStyle}" />
                    </Grid>
                </StackPanel>
            </Border>
        </GroupBox>

        <GroupBox Margin="0,28,0,0"
                  Header="{x:Static res:Strings.Settings_ReferenceProjectsSection}"
                  Style="{StaticResource LauncherContentSectionStyle}">
            <Border Style="{StaticResource SectionFieldSurfaceStyle}">
                <ItemsControl ItemsSource="{Binding ReferenceProjects}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,18"
                                  HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                               Style="{StaticResource SettingsOptionTextStyle}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="{Binding CopyrightNotice}"
                                               Style="{StaticResource SettingsDescriptionTextStyle}" />
                                    <TextBlock Margin="0,2,0,0"
                                               Text="{Binding LicenseText}"
                                               Style="{StaticResource SettingsDescriptionTextStyle}" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Margin="20,0,0,0"
                                        VerticalAlignment="Center"
                                        Content="{x:Static res:Strings.Settings_ViewLegalDocumentButton}"
                                        Command="{Binding DataContext.OpenReferenceProjectCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource LauncherDialogButtonStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </GroupBox>
    </StackPanel>
</UserControl>
